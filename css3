:root{--bg:#fff;--surface:#f4f6fb;--text:#14182b;--muted:#5a6079;--brand:#2f5bff;--brand2:#7a3cff;--wa:#18a957;--border:#dfe3ee;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1020;--surface:#161a30;--text:#eef0fa;--muted:#a3a9c4;--brand:#6c8cff;--brand2:#a77bff;--border:#262b47;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0d1020;--surface:#161a30;--text:#eef0fa;--muted:#a3a9c4;--brand:#6c8cff;--brand2:#a77bff;--border:#262b47;color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(70px + env(safe-area-inset-top,0px))}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;line-height:1.6}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:10}
a{color:inherit;text-decoration:none}
.wrap{max-width:1050px;margin:0 auto;padding:0 20px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:11;background:var(--bg);border-bottom:1px solid var(--border)}
nav{display:flex;align-items:center;justify-content:space-between;height:62px}
.logo{font-weight:800;font-size:1.1rem}.logo span{color:var(--brand)}
nav ul{display:flex;gap:20px;list-style:none;margin:0;padding:0;font-size:.92rem;color:var(--muted)}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:999px;font-weight:700;border:0;cursor:pointer;font-size:1rem}
.btn-main{background:linear-gradient(135deg,var(--brand),var(--brand2));color:#fff}
.btn-wa{background:var(--wa);color:#fff}
.btn-out{border:2px solid var(--border);background:transparent;color:var(--text)}
.hero{padding:72px 0 56px;text-align:center}
.badge{display:inline-block;background:var(--surface);border:1px solid var(--border);padding:6px 14px;border-radius:999px;font-size:.85rem;color:var(--muted)}
h1{font-size:clamp(2rem,6vw,3.4rem);line-height:1.15;margin:18px 0 14px}
h1 em{font-style:normal;background:linear-gradient(135deg,var(--brand),var(--brand2));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{max-width:620px;margin:0 auto 26px;color:var(--muted);font-size:1.1rem}
.cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
section{padding:56px 0}
section.alt{background:var(--surface)}
h2{font-size:1.8rem;margin:0 0 8px}.sub{color:var(--muted);margin:0 0 30px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.card{background:var(--bg);border:1px solid var(--border);border-radius:16px;padding:22px}
.card .ic{font-size:1.8rem}.card h3{margin:10px 0 6px;font-size:1.1rem}.card p{margin:0;color:var(--muted);font-size:.95rem}
.steps{counter-reset:s}.steps .card{position:relative}
.steps .card::before{counter-increment:s;content:counter(s);display:inline-grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--brand);color:#fff;font-weight:800;margin-bottom:8px}
.trust{display:flex;gap:14px;flex-wrap:wrap}
.trust div{flex:1 1 200px;background:var(--bg);border:1px solid var(--border);border-radius:14px;padding:16px;font-weight:600}
.contact{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px}
.info p{margin:8px 0}.info a.num{font-weight:700;font-size:1.15rem;color:var(--brand)}
form{display:grid;gap:12px}
input,select,textarea{width:100%;padding:12px 14px;border-radius:12px;border:1px solid var(--border);background:var(--bg);color:var(--text);font:inherit}
footer{border-top:1px solid var(--border);padding:28px 0;color:var(--muted);font-size:.9rem;text-align:center}
.float{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:12;width:58px;height:58px;border-radius:50%;background:var(--wa);display:grid;place-items:center;box-shadow:0 6px 18px rgba(0,0,0,.3)}
.float svg{width:30px;height:30px;fill:#fff}
@media (max-width:720px){nav ul{display:none}}
